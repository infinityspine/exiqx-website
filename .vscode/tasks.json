{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Auto Commit (5 min loop)",
      "type": "shell",
      "command": "nohup .vscode/auto-commit.sh &",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "group": "none"
    },
    {
      "label": "Stop Auto Commit",
      "type": "shell",
      "command": "pkill -f auto-commit.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "none"
    }
  ]
}