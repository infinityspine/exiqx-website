{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Auto Commit",
      "type": "shell",
      "command": "nohup .vscode/auto-commit.sh &",
      "problemMatcher": [],
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "Stop Auto Commit",
      "type": "shell",
      "command": "pkill -f auto-commit.sh",
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    }
  ]
}